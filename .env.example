# 数据库连接串
# 本地开发用 SQLite，生产部署推荐用 PostgreSQL（Neon / Vercel Postgres / Supabase）
# 示例（PostgreSQL）：
# DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"
DATABASE_URL="file:./dev.db"

# NextAuth 密钥（生产环境必须修改！）
# 生成方式：openssl rand -hex 32
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"

# 站点 URL（部署时改为你的域名）
NEXT_PUBLIC_SITE_URL="https://xiaoyang.com"

# NextAuth URL（部署时改为你的域名）
NEXTAUTH_URL="https://xiaoyang.com"
