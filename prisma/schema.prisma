// Prisma Schema - StudentHub Nav
// SQLite 起步，后续可平滑迁移到 PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- 用户 ----------
model User {
  id           Int       @id @default(autoincrement())
  email        String?   @unique
  phone        String?   @unique
  passwordHash String?
  name         String
  role         String    @default("user") // admin | user
  avatar       String?
  createdAt    DateTime  @default(now())

  submissions  Submission[]
  favorites    Favorite[]
  resources    Resource[]
  questions    Question[]
  answers      Answer[]
  buddyPosts   BuddyPost[]
}

// ---------- 分类 ----------
model Category {
  id        String @id // 如 lang-ja
  type      String     // ai | tool | language
  name      String
  icon      String
  emoji     String?
  sortOrder Int
  sites     Site[]
}

// ---------- 网站 ----------
model Site {
  id          Int      @id @default(autoincrement())
  slug        String   @unique // 对应静态数据 id
  name        String
  aliases     String   // 逗号分隔
  url         String
  logo        String?
  emoji       String?
  tagline     String
  description String?
  category    Category @relation(fields: [categoryId], references: [id])
  categoryId  String
  tags        String   // 逗号分隔
  region      String   // domestic | foreign
  language    String?  // multi | en | ja | ko | es | fr
  isFree      Boolean  @default(false)
  isHot       Boolean  @default(false)
  isNew       Boolean  @default(false)
  isOfficial  Boolean  @default(false)
  clickCount  Int      @default(0)
  status      String   @default("online") // online | offline | pending
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  favorites   Favorite[]

  @@index([categoryId])
  @@index([status])
}

// ---------- 投稿 ----------
model Submission {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id])
  name         String
  url          String
  categorySlug String
  reason       String?
  contact      String?
  status       String   @default("pending") // pending | approved | rejected
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([status])
}

// ---------- 收藏（已登录用户） ----------
model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  siteId    Int
  site      Site     @relation(fields: [siteId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, siteId])
  @@index([userId])
}

// ---------- 举报 ----------
model Report {
  id         Int      @id @default(autoincrement())
  targetType String   // site | resource | question | answer | buddy
  targetId   Int
  reason     String
  contact    String?
  status     String   @default("pending") // pending | resolved | rejected
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([status])
}

// ---------- 三期：学习资源 ----------
model Resource {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id])
  title        String
  subject      String   // 科目/标签：英语四级、高等数学、日语N2…
  resourceType String   // note | paper | ebook | tutorial | link | other
  cover        String?
  summary      String
  fileUrl      String?
  viewCount    Int      @default(0)
  likeCount    Int      @default(0)
  status       String   @default("pending") // pending | online | offline
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([status])
  @@index([subject])
}

// ---------- 三期：问答 ----------
model Question {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  title       String
  content     String
  subject     String?
  answerCount Int      @default(0)
  likeCount   Int      @default(0)
  status      String   @default("online") // online | pending | offline
  answers     Answer[]
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([status])
  @@index([subject])
}

model Answer {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  content    String
  isAccepted Boolean  @default(false)
  likeCount  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([questionId])
}

// ---------- 三期：学习搭子 ----------
model BuddyPost {
  id             Int      @id @default(autoincrement())
  userId         Int
  user           User     @relation(fields: [userId], references: [id])
  title          String
  buddyType      String   // exam | daily | language | project | other
  target         String   // 目标一句话
  description    String
  contact        String?
  maxMembers     Int      @default(5)
  currentMembers Int      @default(1)
  status         String   @default("open") // open | full | closed
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([status])
  @@index([buddyType])
}
